<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Serilog.Sinks.PostmarkEmail</RootNamespace>
    <AssemblyName>Serilog.Sinks.PostmarkEmail</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Serilog.Sinks.PostmarkEmail</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Title>Serilog Postmark Email Sink</Title>
    <Description>A Serilog sink that batches log events and delivers them as email through the Postmark (postmarkapp.com) HTTP API. No dependencies beyond Serilog itself.</Description>
    <PackageTags>serilog;serilog-sink;sink;postmark;postmarkapp;email;logging;smtp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- TODO: set Authors, PackageProjectUrl and RepositoryUrl before publishing to NuGet. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <!-- netstandard2.0 has no in-box System.Text.Json; the modern targets do. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Serilog.Sinks.PostmarkEmail.Tests" />
  </ItemGroup>

</Project>
