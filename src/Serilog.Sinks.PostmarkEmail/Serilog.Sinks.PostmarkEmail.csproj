<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Serilog.Sinks.PostmarkEmail</RootNamespace>
    <AssemblyName>Serilog.Sinks.PostmarkEmail</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Serilog.Sinks.PostmarkEmail</PackageId>
    <!-- Local/CI builds use this. A release build overrides it with -p:Version from the git tag,
         which is the source of truth for anything published to NuGet. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Title>Serilog Postmark Email Sink</Title>
    <Authors>jfgreco</Authors>
    <Description>A Serilog sink that batches log events and delivers them as email through the Postmark (postmarkapp.com) HTTP API. No dependencies beyond Serilog itself.</Description>
    <PackageTags>serilog;serilog-sink;sink;postmark;postmarkapp;email;logging;smtp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/jfgreco/Serilog.Sinks.PostmarkEmail</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jfgreco/Serilog.Sinks.PostmarkEmail.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- SourceLink ships in the .NET SDK, so debugging into the package works with no extra
         PackageReference. ContinuousIntegrationBuild is set by CI only, since it makes paths
         deterministic in a way that hurts local F5 debugging. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <!-- netstandard2.0 has no in-box System.Text.Json; the modern targets do. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Serilog.Sinks.PostmarkEmail.Tests" />
  </ItemGroup>

</Project>
