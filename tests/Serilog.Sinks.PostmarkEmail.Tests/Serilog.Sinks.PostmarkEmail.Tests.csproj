<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted so the library's netstandard2.0-compatible code paths are exercised
         on more than one runtime. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>Serilog.Sinks.PostmarkEmail.Tests</AssemblyName>
    <RootNamespace>Serilog.Sinks.PostmarkEmail.Tests</RootNamespace>
    <!-- xUnit v3 runs on Microsoft.Testing.Platform. `dotnet test` is switched into MTP mode by
         the "test" section in global.json, which is the .NET 10 opt-in; no MSBuild property is
         needed for it. -->
  </PropertyGroup>

  <PropertyGroup>
    <!-- Lets `dotnet user-secrets` store a real Postmark token for the opt-in live test. Secrets
         live in the user profile, never in the repo, so a token cannot be committed by accident. -->
    <UserSecretsId>8f3a1c92-5d47-4b6e-9a10-2c7e4f8b1d63</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Serilog.Sinks.PostmarkEmail/Serilog.Sinks.PostmarkEmail.csproj" />
  </ItemGroup>

</Project>
